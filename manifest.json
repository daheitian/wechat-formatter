{
  "manifest_version": 3,
  "name": "见室排版 · 公众号排版助手",
  "version": "1.0.0",
  "description": "优雅的公众号排版工具：内置多套模板，一键导出到微信公众号、Notion、FlowUs。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "见室排版"
  },
  "permissions": ["clipboardWrite", "storage", "tabs", "activeTab"],
  "host_permissions": ["https://mp.weixin.qq.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
